meta {
  name: Change Password
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/users/me/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "currentPassword": "Password1",
    "newPassword": "Newpass123!"
  }
}

docs {
  Changes current user's password and revokes all active user tokens.

  Response: 200 OK
}
