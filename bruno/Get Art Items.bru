meta {
  name: Get Art Items
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/art-items
  body: none
  auth: none
}

docs {
  Returns an array of art items, each with an optional first image.

  Response: [ArtItemResponse]
  {
    "id": "UUID",
    "name": "string",
    "itemDescription": "string",
    "location": "string",
    "latitude": 0.0,
    "longitude": 0.0,
    "author": "string",
    "state": "string",
    "category": "string",
    "image": {
      "id": "UUID",
      "artItemId": "UUID",
      "img": "base64",
      "date": "ISO8601",
      "timeStamp": 0.0,
      "userId": "UUID"
    } | null
  }
}
