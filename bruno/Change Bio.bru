meta {
  name: Change Bio
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/users/me/bio
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "bio": "Street art lover and explorer"
  }
}

docs {
  Updates current user's bio.

  Response: User.Public
  {
    "id": "UUID",
    "email": "string",
    "username": "string",
    "bio": "string",
    "avatar": "https://host/images/<filename> | null",
    "posted": ["UUID"],
    "visited": ["UUID"],
    "liked": ["UUID"]
  }
}
