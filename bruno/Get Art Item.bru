meta {
  name: Get Art Item
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/art-items/{{itemId}}
  body: none
  auth: none
}

vars:pre-request {
  itemId: 91DD153C-6C04-4ACB-A396-AB7186F54111
}

docs {
  Returns a single art item by ID with an optional first image.
  
  Response: ArtItemResponse
  {
    "id": "UUID",
    "name": "string",
    "itemDescription": "string",
    "location": "string",
    "latitude": 0.0,
    "longitude": 0.0,
    "author": "string",
    "state": "string",
    "category": "string",
    "createdAt": "ISO8601",
    "image": {
      "id": "UUID",
      "artItemId": "UUID",
      "img": "base64",
      "date": "ISO8601",
      "timeStamp": 0.0,
      "userId": "UUID"
    } | null
  }
}
