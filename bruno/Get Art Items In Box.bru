meta {
  name: Get Art Items In Box
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/art-items/in-box?bbox=37.5,55.7,37.7,55.8
  body: none
  auth: none
}

params:query {
  bbox: 37.5,55.7,37.7,55.8
}

docs {
  Returns art items within a bounding box.

  Query params:
    bbox: minLng,minLat,maxLng,maxLat

  Response: [ArtItemResponse]
  {
    "id": "UUID",
    "name": "string",
    "itemDescription": "string",
    "location": "string",
    "latitude": 0.0,
    "longitude": 0.0,
    "author": "string",
    "state": "string",
    "category": "string",
    "createdAt": "ISO8601",
    "image": {
      "id": "UUID",
      "artItemId": "UUID",
      "img": "base64",
      "date": "ISO8601",
      "timeStamp": 0.0,
      "userId": "UUID"
    } | null
  }
}
